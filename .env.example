###############################################################################
# Copy this file to .env.local and fill in real values.
# All VITE_* variables are validated at boot by src/lib/env.ts — empty values
# will block startup intentionally.
###############################################################################

# Public — embedded in the frontend bundle. Safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret — used ONLY by scripts/ via Node (e.g. promote-admin.ts).
# NEVER prefix with VITE_, NEVER import in src/. Bypasses RLS by design.
SUPABASE_SERVICE_ROLE_KEY=
